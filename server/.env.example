# Copiá este archivo a `server/.env` y completá los valores.
# `server/.env` está en .gitignore: nunca subas el secreto real.

# Secreto para firmar los JWT (access tokens e invitaciones).
# Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiame-por-un-secreto-aleatorio-de-48-bytes

# Puerto de la API.
PORT=4000

# Ruta del archivo SQLite (relativa a la raíz del repo).
DB_PATH=server/data/processes.db
